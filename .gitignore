# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Archivos de entorno: se ignoran todos porque llevan credenciales, y este
# sistema maneja datos personales y de menores.
.env*
# La plantilla sin valores SÍ se versiona: es la que dice qué hay que completar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Entorno local con credenciales
.env.local
.env*.local

# Estado local del CLI de Supabase (ref del proyecto vinculado, versiones)
supabase/.temp/
